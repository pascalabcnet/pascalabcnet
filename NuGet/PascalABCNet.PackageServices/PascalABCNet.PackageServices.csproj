<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PascalABCNet.PackageServices</RootNamespace>
    <Description>NuGet package restore and asset selection for PascalABC.NET.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NuGetClientVersion>7.9.0</NuGetClientVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Commands" Version="$(NuGetClientVersion)" />
    <PackageReference Include="NuGet.ProjectModel" Version="$(NuGetClientVersion)" />
    <PackageReference Include="NuGet.Protocol" Version="$(NuGetClientVersion)" />
  </ItemGroup>
</Project>
